# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# This demo environment MUST use a dedicated PostgreSQL schema/user `sdkwork_tts_demo` and a
# dedicated Redis prefix `tts-demo` on a distinct logical DB index so no cache key collides with
# another env sharing the deployment Redis.
SDKWORK_TTS_DEPLOYMENT_PROFILE=cloud
SDKWORK_TTS_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_TTS_PROFILE_ID=cloud.demo
SDKWORK_TTS_APPLICATION_PUBLIC_HTTP_URL=https://tts-demo.sdkwork.com
SDKWORK_TTS_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_TTS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://tts-demo.sdkwork.com,http://tts-demo.sdkwork.com,https://tts-demo.birdcoder.com,http://tts-demo.birdcoder.com,https://tts-demo.dtupay.com,http://tts-demo.dtupay.com,https://tts-demo.noaper.com,http://tts-demo.noaper.com,https://tts-demo.sdkwork.cn,http://tts-demo.sdkwork.cn,https://tts-demo.birdcoder.cn,http://tts-demo.birdcoder.cn,https://tts-demo.dtupay.cn,http://tts-demo.dtupay.cn,https://tts-demo.noaper.cn,http://tts-demo.noaper.cn,https://tts-demo.skubc.com,http://tts-demo.skubc.com,https://tts-demo.skubc.cn,http://tts-demo.skubc.cn,https://tts-demo.zowalk.com,http://tts-demo.zowalk.com,https://tts-demo.zowalk.cn,http://tts-demo.zowalk.cn,https://tts-demo.offer86.com,http://tts-demo.offer86.com,https://tts-demo.offer86.cn,http://tts-demo.offer86.cn,https://tts-demo.86offer.com,http://tts-demo.86offer.com,https://tts-demo.86offer.cn,http://tts-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
