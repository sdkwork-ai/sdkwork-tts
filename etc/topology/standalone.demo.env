# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# This demo environment MUST use a dedicated PostgreSQL schema/user `sdkwork_tts_demo` and a
# dedicated Redis prefix `tts-demo` on a distinct logical DB index so no cache key (session,
# rate-limit, TTS task idempotency) collides with another env sharing the deployment Redis.
SDKWORK_TTS_DEPLOYMENT_PROFILE=standalone
SDKWORK_TTS_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_TTS_PROFILE_ID=standalone.demo
SDKWORK_TTS_APPLICATION_PUBLIC_HTTP_URL=https://tts-demo.sdkwork.com
SDKWORK_TTS_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_TTS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
