# Bootstrap profile cloud.production — replace with application-specific values.
SDKWORK_TTS_DEPLOYMENT_PROFILE=cloud
SDKWORK_TTS_ENVIRONMENT=production
SDKWORK_TTS_PROFILE_ID=cloud.production
SDKWORK_TTS_APPLICATION_PUBLIC_HTTP_URL=https://tts.sdkwork.com
SDKWORK_TTS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_TTS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_CORS_ALLOWED_ORIGINS=https://tts.sdkwork.com,https://tts.birdcoder.com,https://tts.dtupay.com,https://tts.noaper.com,https://tts.sdkwork.cn,https://tts.birdcoder.cn,https://tts.dtupay.cn,https://tts.noaper.cn,https://tts.skubc.com,https://tts.skubc.cn,https://tts.zowalk.com,https://tts.zowalk.cn,https://tts.offer86.com,https://tts.offer86.cn,https://tts.86offer.com,https://tts.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
