{
  "$schema": "https://sdkwork.com/schemas/agent-workflow.schema.json",
  "schemaVersion": "2026-06-06.agent.workflow.v1",
  "workflowRole": "ci-only",
  "app": {
    "id": "sdkwork-tts",
    "repository": "sdkwork-ai/sdkwork-tts"
  },
  "release": {
    "artifactPrefix": "sdkwork-tts",
    "defaultVersion": "0.1.0"
  },
  "toolchains": {
    "rust": "stable"
  },
  "ci": {
    "rust": {
      "commands": [
        "cargo fmt --all -- --check",
        "cargo clippy --no-default-features --features cpu -- -D warnings",
        "cargo test --lib --no-default-features --features cpu"
      ]
    }
  },
  "targets": []
}
